# ============================================================
# SoloEngine 环境变量配置文件
# ============================================================
# 配置链路说明：
#   后端：代码 → settings.XXX → config.py os.getenv("XXX", "默认值") → 根目录/.env
#   前端构建：vite.config.ts → loadEnv(mode, resolve(__dirname, '..'), '') → 根目录/.env
#   前端运行时：代码 → import.meta.env.VITE_XXX（构建时已替换为字面量） → 代码默认值
#
# 注意：
#   1. 本文件位于项目根目录，前后端共享
#   2. 前端运行时仅暴露 VITE_ 前缀的变量（Vite 安全机制）
#   3. 前端构建阶段通过 loadEnv 第三个参数为空字符串可读取所有变量
#   4. LLM API 密钥仅从数据库 LLMConfigModel 读取，不从环境变量读取
#   5. 前后端配置完全分离：前端不通过后端 API 获取环境变量参数
# ============================================================

# ===== 系统用户配置 =====
SYSTEM_USERNAME=system
SYSTEM_PASSWORD=system

# ===== 密钥配置 =====
# JWT 签名密钥（生产环境必须更换为随机字符串）
SECRET_KEY=change-this-secret-key-in-production
# 数据库加密密钥（可选，用于敏感数据加密）
ENCRYPTION_KEY=

# ===== 端口配置 =====
# 后端服务端口（默认8990，严禁改动）
BACKEND_PORT=8990
# 前端开发服务器端口（默认8991，严禁改动）
FRONTEND_PORT=8991

# ===== 时区配置 =====
# 默认时区（默认 UTC，后端存储时间统一使用 UTC，前端显示时从 UTC 转换为用户选择的显示时区）
DEFAULT_TIMEZONE=UTC

# ===== JWT 配置 =====
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ALGORITHM=HS256

# ===== Agent 执行配置 =====
# 最大工具调用迭代次数（默认10）
MAX_ITERATIONS=10

# SubAgent 返回中间步骤
# false: content 只包含最终结果文本（默认）
# true: content 包含完整的模型调用流程（content, reasoning_content, tool_calls）
RETURN_INTERMEDIATE_STEPS=false

# ===== 性能优化配置 =====
# CompiledFlow 缓存最大实例数（默认50，设为0等效于禁用缓存）
COMPILED_FLOW_MAX_INSTANCES=50

# CompiledFlow 缓存超时时间/秒（默认1800，即30分钟，超时后自动失效）
COMPILED_FLOW_CACHE_TIMEOUT=1800

# CompiledFlow 过期清理间隔/秒（默认300，即5分钟，定期清理过期实例）
COMPILED_FLOW_CLEANUP_INTERVAL=300

# WebSocket 主循环最大连续错误数（默认5，超过后断开连接）
MAX_CONSECUTIVE_ERRORS=5

# ===== 会话与调试配置 =====
# RUN_SESSION_TIMEOUT=1800
# MAX_DEBUG_SESSIONS=100
# DEBUG_SESSION_TIMEOUT=3600
# MAX_EXECUTOR_INSTANCES=100
# EXECUTOR_INSTANCE_TIMEOUT=3600

# ===== API 限流配置 =====
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=5/hour

# ===== 文件与请求配置 =====
# API 请求超时/毫秒（默认30000）
# API_REQUEST_TIMEOUT=30000
# 最大文件上传大小/字节（默认50MB）
# MAX_FILE_UPLOAD_SIZE=52428800

# ===== 外部服务 URL =====
# OnlyOffice 文档服务 URL（默认 http://localhost:8993）
ONLYOFFICE_URL=http://localhost:8993
# MCP 默认服务 URL（默认 http://localhost:8080）
MCP_DEFAULT_URL=http://localhost:8080

# ===== 后端超时配置 =====
# Ollama 请求超时/秒（默认300）
# OLLAMA_REQUEST_TIMEOUT=300
# TTS 请求超时/秒（默认60）
# TTS_REQUEST_TIMEOUT=60
# MCP 连接超时/秒（默认30）
# MCP_CONNECT_TIMEOUT=30
# MCP 调用超时/秒（默认60）
# MCP_CALL_TIMEOUT=60
# MCP 最大重试次数（默认3）
# MCP_MAX_RETRIES=3
# 网络工具超时/秒（默认30）
# NETWORK_TOOL_TIMEOUT=30
# 命令默认超时/毫秒（默认30000）
# COMMAND_DEFAULT_TIMEOUT_MS=30000
# 命令最大超时/毫秒（默认600000）
# COMMAND_MAX_TIMEOUT_MS=600000
# Agent 工具超时/秒（默认300）
# AGENT_TOOL_TIMEOUT=300
# 搜索工具超时/秒（默认15）
# SEARCH_TOOL_TIMEOUT=15
# Grep工具超时/秒（默认60，搜索大型项目目录时需要更长超时）
# GREP_TOOL_TIMEOUT=60
# Grep工具最大扫描文件数（默认1000，超过后停止扫描）
# GREP_MAX_FILES=1000
# Playwright 页面超时/毫秒（默认30000）
# PLAYWRIGHT_PAGE_TIMEOUT=30000
# 命令终止超时/秒（默认5）
# COMMAND_TERMINATE_TIMEOUT=5
# Token计数器超时/秒（默认10）
# TOKEN_COUNTER_TIMEOUT=10
# 工具注册请求超时/秒（默认30）
# TOOL_REGISTRY_REQUEST_TIMEOUT=30

# ===== 后端数值配置 =====
# 缓存最大容量（默认500）
# CACHE_MAX_SIZE=500
# 缓存默认TTL/秒（默认300）
# CACHE_DEFAULT_TTL=300
# WebSocket 清理间隔/秒（默认60）
# WEBSOCKET_CLEANUP_INTERVAL=60
# 向量记忆最大容量（默认1000）
# VECTOR_MEMORY_MAX_SIZE=1000
# 向量记忆相似度阈值（默认0.7）
# VECTOR_MEMORY_SIMILARITY_THRESHOLD=0.7
# 文本分块大小（默认500）
# CHUNK_SIZE=500
# 文本分块重叠（默认50）
# CHUNK_OVERLAP=50
# WebSocket 任务取消超时/秒（默认5.0）
# WEBSOCKET_TASK_CANCEL_TIMEOUT=5.0
# WebSocket 流式队列超时/秒（默认1.0）
# WEBSOCKET_STREAM_QUEUE_TIMEOUT=1.0
# 最大连续错误退避基数（默认0.1）
# WEBSOCKET_ERROR_BACKOFF_BASE=0.1
# 最大连续错误退避上限（默认3）
# WEBSOCKET_ERROR_BACKOFF_MAX_CONSECUTIVE=3
# MCP 重试延迟/秒（默认1.0）
# MCP_RETRY_DELAY=1.0
# MCP 服务保活间隔/秒（默认3600）
# MCP_SERVICE_KEEPALIVE_INTERVAL=3600
# 嵌入批次大小（默认2048）
# EMBEDDING_BATCH_SIZE=2048
# 嵌入每批次最大token数（默认8191）
# EMBEDDING_MAX_TOKENS_PER_BATCH=8191
# 网页抓取最大内容长度（默认10000）
# WEB_FETCH_MAX_CONTENT_LENGTH=10000
# 工具注册体截断长度（默认5000）
# TOOL_REGISTRY_BODY_TRUNCATE=5000
# MCP 文件路径参数名（逗号分隔，默认 path,file_path,filePath,...）
# MCP_FILE_PATH_PARAMS=path,file_path,filePath,filepath,source_path,target_path,output_path,destination,notebook_path,image_path,document_path,directory,dir_path,folder_path

# ===== LLM API 密钥 =====
# API 密钥仅从数据库 LLMConfigModel 读取（用户在前端配置），
# 不从环境变量读取。若数据库中未配置，系统直接报错提示用户配置。
# 以下环境变量已废弃，禁止使用：
#   OPENAI_API_KEY, OPENAI_ORGANIZATION, OPENAI_BASE_URL,
#   ANTHROPIC_API_KEY, DASHSCOPE_API_KEY, AZURE_SPEECH_KEY

# ===== 前端运行时配置 =====
# 以下配置通过 Vite 构建时注入到 JS bundle（import.meta.env.VITE_XXX 静态替换为字面量），
# 浏览器运行时直接使用字面量值，不读取文件，不调用后端 API。
# 修改后必须重新构建前端才能生效（npm run build / npm run dev）。
# VITE_ 前缀是必须的：Vite 仅暴露 VITE_ 前缀的环境变量给客户端代码。

# WebSocket 重连间隔/毫秒（默认3000）
VITE_WEBSOCKET_RECONNECT_INTERVAL_MS=3000
# WebSocket 最大重连次数（默认10）
VITE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10
# WebSocket 心跳间隔/毫秒（默认15000）
VITE_WEBSOCKET_HEARTBEAT_INTERVAL_MS=15000
# WebSocket 心跳超时/毫秒（默认45000）
VITE_WEBSOCKET_HEARTBEAT_TIMEOUT_MS=45000
# WebSocket 心跳检测间隔/毫秒（默认10000）
VITE_WEBSOCKET_HEARTBEAT_CHECK_INTERVAL_MS=10000
# WebSocket 最大重连延迟/毫秒（默认30000）
VITE_WEBSOCKET_MAX_RECONNECT_DELAY_MS=30000
# WebSocket Agentic响应超时/秒（默认120，即2分钟，首个chunk未到达或流中断超时）
VITE_WEBSOCKET_RESPONSE_TIMEOUT=120
# API 基础 URL（默认 http://localhost:8990）
VITE_API_BASE_URL=http://localhost:8990
# API 请求超时/毫秒（默认30000）
VITE_API_REQUEST_TIMEOUT=30000
# MCP 请求超时/毫秒（默认30000）
VITE_MCP_REQUEST_TIMEOUT=30000
# OnlyOffice 检查间隔/毫秒（默认60000）
VITE_ONLYOFFICE_CHECK_INTERVAL=60000
# OnlyOffice URL（默认 http://localhost:8080）
VITE_ONLYOFFICE_URL=http://localhost:8080

# ===== 前端画布默认配置 =====
# 默认最大上下文长度（默认4096）
VITE_DEFAULT_MAX_CONTEXT_LENGTH=4096
# 默认最大迭代次数（默认100）
VITE_DEFAULT_MAX_ITERATIONS=100
# 默认超时/秒（默认30）
VITE_DEFAULT_TIMEOUT=30

# ===== 前端执行超时配置 =====
# 执行总超时/秒（默认1800，即30分钟，超时后终止执行）
VITE_EXECUTION_TIMEOUT=1800

# ===== 前端 LLM 默认参数（用于新建配置时的表单初始值） =====
# 默认温度（默认0.7）
VITE_LLM_DEFAULT_TEMPERATURE=0.7
# 默认最大token数（默认128000）
VITE_LLM_DEFAULT_MAX_TOKENS=128000
# LLM max_tokens 最大值上限（默认10240000，前端表单校验最大值上限）
VITE_LLM_MAX_TOKENS_LIMIT=10240000
# 默认top_p（默认1.0）
VITE_LLM_DEFAULT_TOP_P=1.0
# 默认频率惩罚（默认0.0）
VITE_LLM_DEFAULT_FREQUENCY_PENALTY=0.0
# 默认存在惩罚（默认0.0）
VITE_LLM_DEFAULT_PRESENCE_PENALTY=0.0
# 默认超时/秒（默认60）
VITE_LLM_DEFAULT_TIMEOUT=60

# ===== 前端 LLM 供应商默认 Base URL（选择供应商时自动填充，用户可自行修改） =====
# OpenAI 默认 Base URL（默认 https://api.openai.com/v1）
VITE_LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic 默认 Base URL（默认 https://api.anthropic.com）
VITE_LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# 通义千问默认 Base URL（默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
VITE_LLM_PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 默认 Base URL（默认 http://localhost:11434）
VITE_LLM_PROVIDER_OLLAMA_BASE_URL=http://localhost:11434
# DeepSeek 默认 Base URL（默认 https://api.deepseek.com）
VITE_LLM_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 智谱AI 默认 Base URL（默认 https://open.bigmodel.cn/api/paas/v4）
VITE_LLM_PROVIDER_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
