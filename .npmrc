# This machine cannot reliably traverse junctions / reparse points
# ("The path cannot be traversed because it contains an untrusted mount point",
# 0x800701C0), and pnpm's default isolated linker builds node_modules/.pnpm out of
# junctions. Force the hoisted linker so every package is a plain directory, and
# serialise importers so pnpm's importPackage rename never races on Windows
# (fs.rename raises EPERM when the destination directory already exists).
node-linker=hoisted
child-concurrency=1
package-import-method=copy
prefer-offline=true
