{
  "name": "@soloengine/host",
  "version": "0.1.0",
  "description": "SoloEngine 框架挂载：把框架层 Express REST 挂进 dsh host-webserver 的同一条 HTTP 服务（唯一端口），并负责就绪输出与业务库自检。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.form-single.patch.yml": "./cordis.form-single.patch.yml",
    "./cordis.form-cloud.patch.yml": "./cordis.form-cloud.patch.yml",
    "./cordis.executor-container.patch.yml": "./cordis.executor-container.patch.yml",
    "./cordis.executor-vm.patch.yml": "./cordis.executor-vm.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "cordis.form-single.patch.yml",
    "cordis.form-cloud.patch.yml",
    "cordis.executor-container.patch.yml",
    "cordis.executor-vm.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@deepseek-ai/dsh-host-directory-picker-browse": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-shell-env": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-tool-terminal": "workspace:*",
    "@soloengine/cloud-control": "workspace:*",
    "@soloengine/executor-container": "workspace:*",
    "@soloengine/executor-vm": "workspace:*",
    "@soloengine/framework": "workspace:*",
    "@soloengine/image-distribution": "workspace:*",
    "@soloengine/instance-runtime": "workspace:*",
    "@soloengine/subprocess-container": "workspace:*",
    "@soloengine/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-modules": "workspace:*",
    "@deepseek-ai/dsh-cordis-host-runner": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-modules": "workspace:*",
    "@deepseek-ai/dsh-cordis-host-runner": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
