{
  "name": "@soloengine/subprocess-container",
  "version": "0.1.0",
  "description": "SoloEngine 的按会话执行世界子进程提供方（W10.7）：把 shell 命令放进该会话的容器（docker exec）或全 VM（ssh）里执行，工作区映射到 /workspace；无会话路由的命令仍走本机。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@soloengine/executor-container": "workspace:*",
    "@soloengine/executor-vm": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
