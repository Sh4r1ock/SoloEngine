  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@soloengine/cloud-control": "workspace:*",
    "@soloengine/egress-proxy": "workspace:*"
  }
