{
  "name": "@soloengine/executor-container",
  "version": "0.1.0",
  "description": "SoloEngine 容器执行后端（W10.7）：每会话一容器、加固基线、默认拒绝网络、暂停/恢复/销毁。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
