{
  "name": "@soloengine/storage-postgres",
  "version": "0.1.0",
  "description": "SoloEngine 的 PostgreSQL 键值后端：注册为 storage 后端 postgres，与 SQLite 后端同契约、可单独替换。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-storage": "workspace:*",
    "pg": "8.13.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/node": "^22.20.0",
    "@types/pg": "8.11.10"
  }
}
