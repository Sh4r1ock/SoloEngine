{
  "name": "@soloengine/business-db-postgres",
  "version": "0.1.0",
  "description": "SoloEngine 业务库的可选 PostgreSQL 形态：13 表同 schema、共享 schema_versions；框架核心零 pg 依赖。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/schema.postgres.sql"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "8.11.10"
  }
}
