{
  "name": "@soloengine/cloud-control-postgres",
  "version": "0.1.0",
  "description": "SoloEngine 云控制面的可选 PostgreSQL 后端（多节点共享归属库）：实现 @soloengine/cloud-control 的 ControlRepository。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "8.13.1"
  },
  "peerDependencies": {
    "@soloengine/cloud-control": "workspace:*"
  },
  "devDependencies": {
    "@soloengine/cloud-control": "workspace:*",
    "@types/pg": "8.11.10"
  }
}
