{
  "name": "@soloengine/image-distribution",
  "version": "0.1.0",
  "description": "SoloEngine 工作区/镜像分发层（W10.12/W13）：镜像缓存、标准 OCI 分层缓存（按需取层与容量淘汰）、内容寻址工作区对象存储（共享卷或 S3 兼容权威 + 本地副本）、builder/runtime 分离的环境导出。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT"
}
