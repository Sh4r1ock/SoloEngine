{
  "name": "@soloengine/cloud-control",
  "version": "0.1.0",
  "description": "SoloEngine 云 Agent 控制面：节点注册表/健康采集、会话放置（p2c）、会话租约与 epoch 写围栏（W10.2~W10.4）。",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@soloengine/framework": "workspace:*"
  },
  "optionalDependencies": {
    "@soloengine/business-db-postgres": "workspace:*",
    "@soloengine/cloud-control-postgres": "workspace:*"
  }
}
