{
  // Client-side typecheck aggregate for the browser-facing Client programs.
  // Split from the host aggregate because both sides merge cordis Context
  // under the same keys (sessions, loader) with different services; shared
  // leaves (session/llm/tools/...) build once and are referenced by
  // both programs through each client package's own references.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    // Client programs run in the browser; package src purity is each package's
    // own tsconfig.
    "types": ["node"]
  },
  "include": [
    "apps/desktop/src/keyboard.ts",
    "apps/desktop/src/keybindings.ts",
    "apps/desktop/src/browser-guests.ts",
    "apps/desktop/src/ipc.ts",
    "apps/desktop/src/update-overlay.ts",
    "packages/client/*/src/css-modules.d.ts",
    "packages/extensions/ui-cordis/src/css-modules.d.ts",
    "packages/client/tsdown.client.ts",
    "scripts/client-build-environment.ts",
    "scripts/shipped-locales.ts",
    "scripts/bundle-input-isolation.ts",
    "scripts/experimental-package-policy.ts",
  ],
  "references": [
    { "path": "./packages/client/ui-session-status/tsconfig.client.json" },
    { "path": "./packages/client/ui-entry-customization" },
    { "path": "./packages/client/script-realm" },
    { "path": "./packages/client/script-realm-iframe" },

    { "path": "./packages/client/product-analytics/tsconfig.client.json" },
    { "path": "./apps/desktop/tsconfig.client.json" },
    { "path": "./packages/util/atomic-write" },
    { "path": "./packages/client/ui-sidebar-terminal" },
    { "path": "./packages/api/terminal-controller/tsconfig.client.json" },
    { "path": "./packages/ptc-runtime/ptc-runtime" },
